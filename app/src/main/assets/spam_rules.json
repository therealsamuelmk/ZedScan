  "senderBlocklistRegex": [
    "(?i)\\b(prize|reward|promo|winner|lucky|giveaway|refund|claim)[-_. ]*(dept|department|center|centre|team|desk)?\\d*\\b",
    "(?i)\\b(customer[-_. ]?care|help[-_. ]?desk|account[-_. ]?team|security[-_. ]?team)\\b.*@(?!.*(mtn|airtel|zamtel|zanaco|fnb|stanbic|absa|zesco|zra|napsa)\\.)",
