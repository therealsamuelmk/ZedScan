  "regex": [
    { "name": "url_any", "r": "(https?://\\S+)|(www\\.[a-z0-9-]+\\.\\S+)", "w": 18 },
    { "name": "url_shortener", "r": "\\b(bit\\.ly|tinyurl\\.com|t\\.co|rb\\.gy|is\\.gd|cutt\\.ly|goo\\.gl|ow\\.ly|buff\\.ly|shorturl\\.at|tiny\\.cc|lnkd\\.in|rebrand\\.ly)\\b", "w": 16 },
    { "name": "url_ip", "r": "https?://\\d{1,3}(\\.\\d{1,3}){3}", "w": 22 },
    { "name": "url_at_symbol", "r": "https?://[^\\s/]*@", "w": 20 },
    { "name": "url_punycode", "r": "https?://[^\\s/]*xn--", "w": 20 },
    { "name": "url_hex_escape", "r": "%[0-9a-f]{2}.*%[0-9a-f]{2}", "w": 8 },
    { "name": "suspicious_tld", "r": "https?://\\S+?\\.(xyz|top|club|online|click|link|live|shop|work|fit|loan|zip|mov|country|gq|cf|ml|tk|icu|rest|cam)(?:[/:?#]|\\b)", "w": 16 },
    { "name": "money_amount", "r": "(\\bk\\s*\\d{2,}\\b)|(\\bzmw\\s*\\d+)|(\\d+\\s*zmw)|(\\d+\\s*kwacha)|(\\$\\s*\\d+)|(\\busd\\s*\\d+)|(\\bngn\\s*\\d+)|(\\bR\\s*\\d{3,})", "w": 10 },
    { "name": "otp_request", "r": "(send|share|give|provide|forward|tell|confirm|verify|enter|re-?enter|update|submit)\\s+(me\\s+)?(us\\s+)?(your\\s+)?(otp|pin|password|one\\s*time\\s*password|verification\\s*code|security\\s*code)", "w": 24 },
    { "name": "bank_detail_request", "r": "(reply|respond|send|share|provide|confirm|update|submit)\\s+(with\\s+|us\\s+|me\\s+)?(your\\s+)?(full\\s+)?(bank|card|account|banking|atm|wallet)\\s+(details|detail|number|no|info|information|credentials)", "w": 16 },
    { "name": "earnings_bait", "r": "(earn|make|get)\\s+(up\\s+to\\s+)?(k|zmw|\\$|usd)?\\s*\\d{2,}\\s*(k)?\\s*(per|a|each|every)\\s*(day|week|hour)", "w": 14 },
    { "name": "phone_callback", "r": "(call|whatsapp|text|dial|sms)\\s+(us\\s+)?(back\\s+)?(on|at)?\\s*[:]?\\s*(\\+?\\d[\\d\\s().-]{7,}\\d)", "w": 8 },
    { "name": "gmail_lookalike", "r": "@(g[e3]mail|gnail|gmial|gmai1|yah00|yaho0|0utlook|hotmial|hotrnail)\\.", "w": 20 },
    { "name": "excess_punct", "r": "([!?$*]\\s*){3,}", "w": 8 },
    { "name": "spaced_letters", "r": "(?:\\b|^)(?:[a-z0-9]\\s+){4,}[a-z0-9](?:\\b|$)", "w": 10 },
    { "name": "reward_points_expiry", "r": "(reward|loyalty|bonus)\\s*points?.*(expir|will\\s*expire|about\\s*to\\s*expire)", "w": 12 },
    { "name": "generic_greeting", "r": "^(dear\\s+(customer|user|client|member|account\\s*holder|valued\\s*customer))\\b", "w": 6 },
    { "name": "attachment_bait", "r": "(open|view|download|click)\\s+(the\\s+)?attach(ed|ment)\\b|\\battached\\s+(invoice|document|file|receipt|statement|form|contract|order)\\b", "w": 9 }
  ],

