<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#14000000"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/riskStripe"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/history_risk_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/zed_green_700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/riskBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="SUSPICIOUS"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/history_risk_medium_bg"
                    android:textColor="@color/history_risk_medium"
                    app:elevation="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/zed_text" />

            <TextView
                android:id="@+id/txtSnippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="@color/zed_text"
                android:alpha="0.80"
                android:maxLines="3"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="#12000000" />

            <TextView
                android:id="@+id/txtIntel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/zed_text"
                android:alpha="0.72"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>